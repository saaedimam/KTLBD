<!-- Bangladesh map for contact section -->
<svg width="500" height="400" viewBox="0 0 500 400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="mapGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1e293b;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#334155;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="500" height="400" fill="url(#mapGrad)"/>
  
  <!-- Simplified Bangladesh outline -->
  <path d="M150 100 Q200 80 250 100 Q300 120 350 150 Q380 200 350 250 Q300 300 250 280 Q200 260 150 240 Q120 200 150 100 Z" 
        fill="#0EA5A5" opacity="0.6" stroke="#0EA5A5" stroke-width="2"/>
  
  <!-- Chittagong location marker -->
  <circle cx="280" cy="220" r="8" fill="#8B0000"/>
  <circle cx="280" cy="220" r="15" fill="none" stroke="#8B0000" stroke-width="2" opacity="0.6"/>
  <circle cx="280" cy="220" r="25" fill="none" stroke="#8B0000" stroke-width="1" opacity="0.3"/>
  
  <!-- Location label -->
  <text x="280" y="250" font-family="Inter" font-size="14" font-weight="bold" text-anchor="middle" fill="#ffffff">Chittagong</text>
  <text x="280" y="270" font-family="Inter" font-size="12" text-anchor="middle" fill="#0EA5A5">KTL Headquarters</text>
  
  <!-- Grid overlay -->
  <defs>
    <pattern id="mapGrid" width="50" height="50" patternUnits="userSpaceOnUse">
      <path d="M 50 0 L 0 0 0 50" fill="none" stroke="#0EA5A5" stroke-width="0.5" opacity="0.2"/>
    </pattern>
  </defs>
  <rect width="500" height="400" fill="url(#mapGrid)"/>
</svg>