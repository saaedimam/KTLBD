<!-- Aerial view of garment factory -->
<svg width="600" height="400" viewBox="0 0 600 400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="factoryAerial" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1e293b;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#334155;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="600" height="400" fill="url(#factoryAerial)"/>
  
  <!-- Factory buildings -->
  <rect x="50" y="100" width="200" height="150" fill="#0EA5A5" opacity="0.8" rx="5"/>
  <rect x="270" y="120" width="180" height="130" fill="#8B0000" opacity="0.8" rx="5"/>
  <rect x="470" y="80" width="120" height="170" fill="#0EA5A5" opacity="0.6" rx="5"/>
  
  <!-- Production lines -->
  <rect x="60" y="110" width="20" height="130" fill="#ffffff" opacity="0.3"/>
  <rect x="90" y="110" width="20" height="130" fill="#ffffff" opacity="0.3"/>
  <rect x="120" y="110" width="20" height="130" fill="#ffffff" opacity="0.3"/>
  <rect x="150" y="110" width="20" height="130" fill="#ffffff" opacity="0.3"/>
  <rect x="180" y="110" width="20" height="130" fill="#ffffff" opacity="0.3"/>
  <rect x="210" y="110" width="20" height="130" fill="#ffffff" opacity="0.3"/>
  
  <!-- Pathways -->
  <rect x="0" y="280" width="600" height="20" fill="#475569" opacity="0.6"/>
  <rect x="250" y="0" width="20" height="400" fill="#475569" opacity="0.6"/>
</svg>