<!-- Green textile, recycling loop, solar panels -->
<svg width="700" height="500" viewBox="0 0 700 500" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="greenGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#10b981;stop-opacity:0.8" />
      <stop offset="100%" style="stop-color:#059669;stop-opacity:0.8" />
    </linearGradient>
  </defs>
  
  <!-- Solar panels -->
  <rect x="50" y="100" width="200" height="80" fill="#1e293b" rx="5"/>
  <rect x="60" y="110" width="180" height="60" fill="url(#greenGrad)" rx="3"/>
  <rect x="70" y="120" width="40" height="40" fill="#ffffff" opacity="0.2"/>
  <rect x="120" y="120" width="40" height="40" fill="#ffffff" opacity="0.2"/>
  <rect x="170" y="120" width="40" height="40" fill="#ffffff" opacity="0.2"/>
  
  <!-- Recycling symbol -->
  <g transform="translate(400, 150)">
    <path d="M0 -30 L20 10 L-20 10 Z" fill="#10b981" opacity="0.8"/>
    <path d="M26 -15 L6 25 L46 25 Z" fill="#10b981" opacity="0.8" transform="rotate(120)"/>
    <path d="M26 -15 L6 25 L46 25 Z" fill="#10b981" opacity="0.8" transform="rotate(240)"/>
    <circle cx="0" cy="0" r="35" fill="none" stroke="#10b981" stroke-width="2" opacity="0.6"/>
  </g>
  
  <!-- Green textile representation -->
  <rect x="100" y="300" width="500" height="150" fill="url(#greenGrad)" opacity="0.3" rx="10"/>
  <path d="M120 350 Q200 320 280 350 T440 350 T600 350" stroke="#10b981" stroke-width="4" fill="none"/>
  <path d="M120 370 Q200 340 280 370 T440 370 T600 370" stroke="#059669" stroke-width="4" fill="none"/>
  <path d="M120 390 Q200 360 280 390 T440 390 T600 390" stroke="#10b981" stroke-width="4" fill="none"/>
  
  <!-- Eco-friendly icons -->
  <circle cx="550" cy="120" r="25" fill="#10b981" opacity="0.6"/>
  <text x="550" y="128" font-family="Inter" font-size="20" text-anchor="middle" fill="#ffffff">♻</text>
  
  <circle cx="150" cy="250" r="20" fill="#059669" opacity="0.6"/>
  <text x="150" y="257" font-family="Inter" font-size="16" text-anchor="middle" fill="#ffffff">🌱</text>
  
  <circle cx="500" cy="250" r="20" fill="#10b981" opacity="0.6"/>
  <text x="500" y="257" font-family="Inter" font-size="16" text-anchor="middle" fill="#ffffff">💧</text>
</svg>