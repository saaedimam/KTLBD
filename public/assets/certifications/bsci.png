  <text x="60" y="75" font-family="Inter" font-size="8" text-anchor="middle" fill="#3b82f6">COMPLIANT</text>
  <path d="M35 40 L50 50 L85 25" stroke="#3b82f6" stroke-width="3" fill="none"/>
</svg>