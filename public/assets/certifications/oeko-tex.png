<!-- OEKO-TEX certification logo -->
<svg width="120" height="120" viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="oekoGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0EA5A5;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#059669;stop-opacity:1" />
    </linearGradient>
  </defs>
  <circle cx="60" cy="60" r="55" fill="url(#oekoGrad)"/>
  <circle cx="60" cy="60" r="45" fill="#ffffff"/>
  <text x="60" y="50" font-family="Inter" font-size="12" font-weight="bold" text-anchor="middle" fill="#0EA5A5">OEKO</text>
  <text x="60" y="70" font-family="Inter" font-size="12" font-weight="bold" text-anchor="middle" fill="#0EA5A5">TEX</text>
  <circle cx="60" cy="60" r="35" fill="none" stroke="#0EA5A5" stroke-width="2"/>
</svg>