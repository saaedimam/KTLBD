<!-- ISO 9001 certification logo -->
<svg width="120" height="120" viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="isoGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#8B0000;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#dc2626;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect x="10" y="10" width="100" height="100" fill="url(#isoGrad)" rx="10"/>
  <rect x="20" y="20" width="80" height="80" fill="#ffffff" rx="5"/>
  <text x="60" y="45" font-family="Inter" font-size="14" font-weight="bold" text-anchor="middle" fill="#8B0000">ISO</text>
  <text x="60" y="65" font-family="Inter" font-size="14" font-weight="bold" text-anchor="middle" fill="#8B0000">9001</text>
  <text x="60" y="85" font-family="Inter" font-size="8" text-anchor="middle" fill="#8B0000">CERTIFIED</text>
</svg>