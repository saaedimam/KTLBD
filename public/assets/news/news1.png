<!-- News article 1 image -->
<svg width="400" height="250" viewBox="0 0 400 250" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="news1Grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0EA5A5;stop-opacity:0.8" />
      <stop offset="100%" style="stop-color:#059669;stop-opacity:0.8" />
    </linearGradient>
  </defs>
  <rect width="400" height="250" fill="url(#news1Grad)"/>
  <rect x="50" y="50" width="300" height="150" fill="#ffffff" opacity="0.2" rx="10"/>
  <text x="200" y="100" font-family="Inter" font-size="18" font-weight="bold" text-anchor="middle" fill="#ffffff">New Sustainability</text>
  <text x="200" y="125" font-family="Inter" font-size="18" font-weight="bold" text-anchor="middle" fill="#ffffff">Initiative Launched</text>
  <text x="200" y="160" font-family="Inter" font-size="12" text-anchor="middle" fill="#ffffff">KTL introduces eco-friendly</text>
  <text x="200" y="180" font-family="Inter" font-size="12" text-anchor="middle" fill="#ffffff">production processes</text>
</svg>