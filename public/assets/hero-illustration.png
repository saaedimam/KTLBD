<!-- Factory and garments concept art -->
<svg width="800" height="600" viewBox="0 0 800 600" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="factoryGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0EA5A5;stop-opacity:0.8" />
      <stop offset="100%" style="stop-color:#8B0000;stop-opacity:0.8" />
    </linearGradient>
  </defs>
  <!-- Factory building -->
  <rect x="100" y="200" width="600" height="300" fill="url(#factoryGrad)" rx="10"/>
  <rect x="120" y="220" width="80" height="60" fill="#ffffff" opacity="0.3" rx="5"/>
  <rect x="220" y="220" width="80" height="60" fill="#ffffff" opacity="0.3" rx="5"/>
  <rect x="320" y="220" width="80" height="60" fill="#ffffff" opacity="0.3" rx="5"/>
  <rect x="420" y="220" width="80" height="60" fill="#ffffff" opacity="0.3" rx="5"/>
  <rect x="520" y="220" width="80" height="60" fill="#ffffff" opacity="0.3" rx="5"/>
  <rect x="620" y="220" width="80" height="60" fill="#ffffff" opacity="0.3" rx="5"/>
  
  <!-- Textile patterns -->
  <path d="M50 100 Q200 50 350 100 T650 100" stroke="#0EA5A5" stroke-width="3" fill="none" opacity="0.6"/>
  <path d="M50 120 Q200 70 350 120 T650 120" stroke="#8B0000" stroke-width="3" fill="none" opacity="0.6"/>
  <path d="M50 140 Q200 90 350 140 T650 140" stroke="#0EA5A5" stroke-width="3" fill="none" opacity="0.6"/>
  
  <!-- Floating elements -->
  <circle cx="150" cy="80" r="8" fill="#0EA5A5" opacity="0.7"/>
  <circle cx="650" cy="120" r="6" fill="#8B0000" opacity="0.7"/>
  <circle cx="400" cy="60" r="10" fill="#0EA5A5" opacity="0.5"/>
</svg>