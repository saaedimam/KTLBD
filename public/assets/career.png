<!-- People working in office/factory -->
<svg width="700" height="400" viewBox="0 0 700 400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="careerGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1e293b;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#334155;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <rect width="700" height="400" fill="url(#careerGrad)"/>
  
  <!-- Office/Factory environment -->
  <rect x="50" y="150" width="600" height="200" fill="#0EA5A5" opacity="0.2" rx="10"/>
  
  <!-- Workstations -->
  <rect x="100" y="200" width="80" height="60" fill="#ffffff" opacity="0.3" rx="5"/>
  <rect x="200" y="200" width="80" height="60" fill="#ffffff" opacity="0.3" rx="5"/>
  <rect x="300" y="200" width="80" height="60" fill="#ffffff" opacity="0.3" rx="5"/>
  <rect x="400" y="200" width="80" height="60" fill="#ffffff" opacity="0.3" rx="5"/>
  <rect x="500" y="200" width="80" height="60" fill="#ffffff" opacity="0.3" rx="5"/>
  
  <!-- Workers at stations -->
  <g transform="translate(140, 180)">
    <circle cx="0" cy="0" r="12" fill="#ffffff" opacity="0.9"/>
    <rect x="-8" y="12" width="16" height="25" fill="#ffffff" opacity="0.9" rx="2"/>
  </g>
  
  <g transform="translate(240, 180)">
    <circle cx="0" cy="0" r="12" fill="#ffffff" opacity="0.9"/>
    <rect x="-8" y="12" width="16" height="25" fill="#ffffff" opacity="0.9" rx="2"/>
  </g>
  
  <g transform="translate(340, 180)">
    <circle cx="0" cy="0" r="12" fill="#ffffff" opacity="0.9"/>
    <rect x="-8" y="12" width="16" height="25" fill="#ffffff" opacity="0.9" rx="2"/>
  </g>
  
  <g transform="translate(440, 180)">
    <circle cx="0" cy="0" r="12" fill="#ffffff" opacity="0.9"/>
    <rect x="-8" y="12" width="16" height="25" fill="#ffffff" opacity="0.9" rx="2"/>
  </g>
  
  <g transform="translate(540, 180)">
    <circle cx="0" cy="0" r="12" fill="#ffffff" opacity="0.9"/>
    <rect x="-8" y="12" width="16" height="25" fill="#ffffff" opacity="0.9" rx="2"/>
  </g>
  
  <!-- Career opportunities text -->
  <text x="350" y="100" font-family="Inter" font-size="24" font-weight="bold" text-anchor="middle" fill="#0EA5A5">Join Our Team</text>
  <text x="350" y="130" font-family="Inter" font-size="16" text-anchor="middle" fill="#ffffff">850+ Professionals • Growth Opportunities</text>
  
  <!-- Job categories -->
  <rect x="100" y="300" width="120" height="40" fill="#8B0000" opacity="0.6" rx="5"/>
  <text x="160" y="325" font-family="Inter" font-size="12" font-weight="bold" text-anchor="middle" fill="#ffffff">Production</text>
  
  <rect x="240" y="300" width="120" height="40" fill="#0EA5A5" opacity="0.6" rx="5"/>
  <text x="300" y="325" font-family="Inter" font-size="12" font-weight="bold" text-anchor="middle" fill="#ffffff">Quality Control</text>
  
  <rect x="380" y="300" width="120" height="40" fill="#059669" opacity="0.6" rx="5"/>
  <text x="440" y="325" font-family="Inter" font-size="12" font-weight="bold" text-anchor="middle" fill="#ffffff">Management</text>
  
  <rect x="520" y="300" width="120" height="40" fill="#f59e0b" opacity="0.6" rx="5"/>
  <text x="580" y="325" font-family="Inter" font-size="12" font-weight="bold" text-anchor="middle" fill="#ffffff">Engineering</text>
</svg>