<!-- Impact stories illustration -->
<svg width="600" height="400" viewBox="0 0 600 400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="impactGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0EA5A5;stop-opacity:0.6" />
      <stop offset="100%" style="stop-color:#8B0000;stop-opacity:0.6" />
    </linearGradient>
  </defs>
  
  <!-- Community impact visualization -->
  <rect x="50" y="100" width="500" height="200" fill="url(#impactGrad)" rx="15"/>
  
  <!-- People figures -->
  <g transform="translate(100, 150)">
    <circle cx="0" cy="0" r="15" fill="#ffffff" opacity="0.9"/>
    <rect x="-10" y="15" width="20" height="30" fill="#ffffff" opacity="0.9" rx="3"/>
  </g>
  
  <g transform="translate(200, 150)">
    <circle cx="0" cy="0" r="15" fill="#ffffff" opacity="0.9"/>
    <rect x="-10" y="15" width="20" height="30" fill="#ffffff" opacity="0.9" rx="3"/>
  </g>
  
  <g transform="translate(300, 150)">
    <circle cx="0" cy="0" r="15" fill="#ffffff" opacity="0.9"/>
    <rect x="-10" y="15" width="20" height="30" fill="#ffffff" opacity="0.9" rx="3"/>
  </g>
  
  <g transform="translate(400, 150)">
    <circle cx="0" cy="0" r="15" fill="#ffffff" opacity="0.9"/>
    <rect x="-10" y="15" width="20" height="30" fill="#ffffff" opacity="0.9" rx="3"/>
  </g>
  
  <g transform="translate(500, 150)">
    <circle cx="0" cy="0" r="15" fill="#ffffff" opacity="0.9"/>
    <rect x="-10" y="15" width="20" height="30" fill="#ffffff" opacity="0.9" rx="3"/>
  </g>
  
  <!-- Impact metrics -->
  <text x="300" y="50" font-family="Inter" font-size="20" font-weight="bold" text-anchor="middle" fill="#0EA5A5">Community Impact</text>
  <text x="300" y="250" font-family="Inter" font-size="14" text-anchor="middle" fill="#ffffff">850+ Jobs Created • 5000+ Families Supported</text>
  <text x="300" y="270" font-family="Inter" font-size="14" text-anchor="middle" fill="#ffffff">Education Programs • Healthcare Initiatives</text>
  
  <!-- Achievement badges -->
  <circle cx="100" cy="350" r="25" fill="#10b981" opacity="0.8"/>
  <text x="100" y="357" font-family="Inter" font-size="12" font-weight="bold" text-anchor="middle" fill="#ffffff">CSR</text>
  
  <circle cx="300" cy="350" r="25" fill="#f59e0b" opacity="0.8"/>
  <text x="300" y="357" font-family="Inter" font-size="12" font-weight="bold" text-anchor="middle" fill="#ffffff">EDU</text>
  
  <circle cx="500" cy="350" r="25" fill="#ef4444" opacity="0.8"/>
  <text x="500" y="357" font-family="Inter" font-size="12" font-weight="bold" text-anchor="middle" fill="#ffffff">HEALTH</text>
</svg>