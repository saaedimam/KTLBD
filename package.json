{
  "name": "vanilla-js-site",
  "version": "1.0.0",
  "description": "KTL static site",
  "scripts": {
    "build": "node build.js",
    "dev": "npm run build && node serve.js",
    "start": "node serve.js",
    "dev:project": "npm --prefix project run dev",
    "start:project": "npm --prefix project run start",
    "build:project": "npm --prefix project run build",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.{js,css,html,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,css,html,json,md}\"",
    "prepare": "husky"
  },
  "engines": {
    "node": "^20"
  },
  "devDependencies": {
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^17.10.3",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "vite": "^7.1.3"
  },
  "lint-staged": {
    "scripts/**/*.js": [
      "eslint --fix"
    ],
    "{build.js,index.js,serve.js}": [
      "eslint --fix"
    ],
    "project/**/*.{js,ts,tsx}": [
      "eslint --config project/eslint.config.js --fix"
    ],
    "**/*.{css,html,md,json}": [
      "prettier --write"
    ]
  }
}
